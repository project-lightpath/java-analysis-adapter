<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.projectlightpath</groupId>
  <artifactId>flpath-java-analysis-adapter</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>FLPATH Java analysis adapter</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <sootup.version>3.0.1</sootup.version>
    <jackson.version>2.17.2</jackson.version>
    <junit.version>5.11.0</junit.version>
    <test.heap>-Xmx10g</test.heap>
    <pmd.version>7.17.0</pmd.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.soot-oss</groupId>
      <artifactId>sootup.callgraph</artifactId>
      <version>${sootup.version}</version>
    </dependency>
    <dependency>
      <groupId>org.soot-oss</groupId>
      <artifactId>sootup.java.bytecode.frontend</artifactId>
      <version>${sootup.version}</version>
    </dependency>
    <dependency>
      <groupId>org.soot-oss</groupId>
      <artifactId>sootup.java.core</artifactId>
      <version>${sootup.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <!-- Parallel JUnit execution builds several SootUp scenes at once.
               make adapter-test sizes this from the host via -Dtest.heap. -->
          <argLine>${test.heap}</argLine>
        </configuration>
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <excludedGroups>large-archive,sootup</excludedGroups>
            </configuration>
          </execution>
          <execution>
            <id>large-archive-test</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <groups>large-archive</groups>
              <argLine>-Xmx1g</argLine>
              <reportsDirectory>${project.build.directory}/surefire-reports-large</reportsDirectory>
            </configuration>
          </execution>
          <execution>
            <id>sootup-test</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <groups>sootup</groups>
              <!-- One concurrent SootUp scene needs ~3 GB of ASM-materialized
                   classpath (measured: 1-3 GB heaps OOM the lane). Bounded for
                   the 16 GB CI runner; reduced parallelism, own reports. -->
              <argLine>-Xmx6g -Djunit.jupiter.execution.parallel.config.fixed.parallelism=2</argLine>
              <reportsDirectory>${project.build.directory}/surefire-reports-sootup</reportsDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>3.28.0</version>
        <configuration>
          <rulesets>
            <ruleset>${project.basedir}/config/pmd-production.xml</ruleset>
          </rulesets>
          <includeTests>false</includeTests>
          <failOnViolation>false</failOnViolation>
          <skipPmdError>false</skipPmdError>
          <format>xml</format>
          <outputDirectory>${project.build.directory}/java-lint</outputDirectory>
          <pmdVersion>${pmd.version}</pmdVersion>
          <targetJdk>${maven.compiler.release}</targetJdk>
          <typeResolution>false</typeResolution>
          <minimumPriority>3</minimumPriority>
          <linkXRef>false</linkXRef>
          <skipEmptyReport>false</skipEmptyReport>
          <minimumTokens>100</minimumTokens>
          <ignoreAnnotations>true</ignoreAnnotations>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
